From 1235fa27ab0e9975e4f762b8f59f5d521abb5da2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 2 May 2026 03:36:07 +0000
Subject: [PATCH] fix(tcp): enable SO_KEEPALIVE on outbound connections

Without TCP keepalive, idle relay sessions and port-forwarded TCP
tunnels are silently dropped by NATs with short idle timeouts (e.g.
CGNAT, ~30s). libpq-level keepalives don't help because they run on
the loopback socket between the client app and the local end of the
tunnel; they never reach the socket that crosses the NAT.

Apply set_keepalive with 15s idle right after set_nodelay in
FramedStream::new, using the same raw-fd round-trip idiom already
used by listen_any to apply socket2 options to a tokio socket. No
new dependencies; socket2 0.3 is already pulled in.

Idle interval and retry count fall back to OS defaults (Windows
defaults are aggressive enough to keep the NAT mapping alive).

https://claude.ai/code/session_01PexR3t1UTu1zUqWvtHoUa5
---
 src/tcp.rs | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/src/tcp.rs b/src/tcp.rs
index 2296edb..7248329 100644
--- a/src/tcp.rs
+++ b/src/tcp.rs
@@ -97,6 +97,34 @@ impl FramedStream {
                     super::timeout(ms_timeout, socket.connect(remote_addr)).await
                 {
                     stream.set_nodelay(true).ok();
+                    // Enable TCP keepalive so the connection survives idle
+                    // periods on NATs with short timeouts (e.g. CGNAT, which
+                    // often drops idle flows after ~30s). Without this,
+                    // port-forwarded tunnels and long-lived control sessions
+                    // get silently severed.
+                    #[cfg(unix)]
+                    {
+                        use std::os::unix::io::{AsRawFd, FromRawFd, IntoRawFd};
+                        let raw_fd = stream.as_raw_fd();
+                        let sock2 = unsafe { socket2::Socket::from_raw_fd(raw_fd) };
+                        sock2
+                            .set_keepalive(Some(std::time::Duration::from_secs(15)))
+                            .ok();
+                        let _ = sock2.into_raw_fd();
+                    }
+                    #[cfg(windows)]
+                    {
+                        use std::os::windows::prelude::{
+                            AsRawSocket, FromRawSocket, IntoRawSocket,
+                        };
+                        let raw_socket = stream.as_raw_socket();
+                        let sock2 =
+                            unsafe { socket2::Socket::from_raw_socket(raw_socket) };
+                        sock2
+                            .set_keepalive(Some(std::time::Duration::from_secs(15)))
+                            .ok();
+                        let _ = sock2.into_raw_socket();
+                    }
                     let addr = stream.local_addr()?;
                     return Ok(Self(
                         Framed::new(DynTcpStream(Box::new(stream)), BytesCodec::new()),
-- 
